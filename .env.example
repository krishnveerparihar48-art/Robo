# Government Job Updates Telegram Bot - Configuration Example
# Copy this file to .env and fill in your actual values

# ============================================================================
# BOT CREDENTIALS
# ============================================================================

# Get your bot token from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Your Telegram User ID (numeric, e.g., 123456789)
# Get from @userinfobot on Telegram
ADMIN_ID=123456789

# Your Channel ID (negative number, e.g., -1001234567890)
# Get from @userinfobot by sending a message from your channel or bot
CHANNEL_ID=-1001234567890

# Your channel username (without @)
CHANNEL_USERNAME=Roboallbotchannel

# ============================================================================
# BOT SETTINGS
# ============================================================================

# Scrape interval in hours (default: 3)
SCRAPE_INTERVAL_HOURS=3

# Request delay in seconds between websites (default: 3)
REQUEST_DELAY_SECONDS=3

# Maximum retries for failed requests (default: 3)
MAX_RETRIES=3

# Request timeout in seconds (default: 30)
REQUEST_TIMEOUT=30

# ============================================================================
# PATHS
# ============================================================================

# Database directory
DATABASE_DIR=database

# Logs directory
LOGS_DIR=logs

# Backups directory
BACKUPS_DIR=backups

# ============================================================================
# OTHER SETTINGS
# ============================================================================

# Timezone for all time displays
TIMEZONE=Asia/Kolkata

# Jobs to show per feed
JOBS_PER_FEED=5

# Telegram message limit (don't change)
MESSAGE_LIMIT=4096
